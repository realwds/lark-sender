# 默认自动检测，提交时统一 LF，检出时按平台转换
* text=auto

# 源码与配置统一 LF
*.cs      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows 批处理必须 CRLF，否则 cmd 可能解析异常
*.cmd     text eol=crlf
*.bat     text eol=crlf

# 二进制
*.exe     binary
*.ico     binary
*.png     binary